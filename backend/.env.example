SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=nodebeacon
DB_USER=nodebeacon_app
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Address reachable by installed agents, not the monitored PC's IP.
# Blank uses the backend URL of the authenticated download request.
AGENT_PUBLIC_URL=

# Optional email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Unlock emails use the existing Gmail SMTP configuration in settings.py.
# Use an SMTP app password; never put an account's normal password here.
DEFAULT_FROM_EMAIL=noreply@nodebeacon.local

# Optional Telegram notifications. Create a bot with @BotFather; never commit
# or share its token. Set it only in your private backend/.env.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional local development test recipient only; production alerts use the
# authenticated user's verified Telegram pairing stored in the database.
TELEGRAM_CHAT_ID=

FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional explicit override (matches Authorized redirect URI in Google Cloud Console):
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

